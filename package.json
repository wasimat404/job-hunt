{
  "name": "jobtracker-cli",
  "version": "0.1.0",
  "description": "CLI for tracking daily job applications, streaks, and stats.",
  "type": "module",
  "bin": {
    "jobhunt": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["cli", "job-tracker", "productivity", "typescript"],
  "author": "Wasim (wasims.vercel.app)",
  "license": "MIT",
  "dependencies": {
